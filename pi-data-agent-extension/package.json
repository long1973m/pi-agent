{
  "name": "pi-data-agent-extension",
  "version": "0.14.4",
  "description": "Natural-language data analysis for Pi: DuckDB querying, semantic data dictionary, analysis skills, charts, reports, and a local dashboard",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/long1973m/pi-agent.git",
    "directory": "pi-data-agent-extension"
  },
  "homepage": "https://github.com/long1973m/pi-agent/tree/main/pi-data-agent-extension",
  "bugs": "https://github.com/long1973m/pi-agent/issues",
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsc && cp -r src/dashboard/static dist/dashboard/",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check && npm run build"
  },
  "files": [
    "dist",
    "skills",
    "requirements.txt",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "express": "^4.21.2",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "data-agent",
    "duckdb",
    "analytics",
    "sql",
    "data-visualization"
  ],
  "license": "MIT"
}
