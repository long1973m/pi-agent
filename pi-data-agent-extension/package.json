{
  "name": "pi-data-agent-extension",
  "version": "0.1.0",
  "description": "Pi Data Agent Extension - S0.1 PoC for MVP validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsc && cp -r src/dashboard/static dist/dashboard/",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "npx tsx src/eval/run-all-v2.ts",
    "test:all": "npm run test && npm run test:legacy",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@sinclair/typebox": "^0.34.0",
    "express": "^4.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "pi-extension",
    "data-agent",
    "duckdb",
    "analytics"
  ],
  "license": "MIT"
}
